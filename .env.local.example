# Copier ce fichier en `.env.local` et renseigner les valeurs réelles.
# `.env.local` est gitignoré ; ce fichier-ci est versionné.

# URL du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publishable Supabase (safe côté client — jamais la clé service_role ici)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
